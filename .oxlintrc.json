{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error",
    "style": "error",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "globals": {
    "React": "readonly"
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "public/**",
    "coverage/**",
    "next-env.d.ts",
    "node_modules/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "sort-imports": ["error", { "ignoreDeclarationSort": true }],
    "no-alert": "error",
    "no-var": "error",
    "no-empty": "error",
    "no-empty-function": "error",
    "no-console": "off",

    // `return` with no value is deliberate here: the callbacks are typed
    // `(T | undefined)[]` and use it to signal a skipped element.
    "array-callback-return": ["error", { "allowImplicit": true }],

    // Rules ESLint never enforced that fire on established, deliberate style.
    // Enabling them would mean a codebase-wide rewrite, not a toolchain swap.
    "curly": "off",
    "no-else-return": "off",
    "operator-assignment": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/numeric-separators-style": "off",
    // Would rewrite `Number.parseInt(hour, 10)` to `Math.trunc(Number(hour))`,
    // which is NOT equivalent: parseInt("12abc") is 12, Number("12abc") is NaN.
    "unicorn/prefer-number-coercion": "off",

    "typescript/no-explicit-any": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-var-requires": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-namespace": ["error", { "allowDeclarations": true }],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],

    "unicorn/import-style": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-anonymous-default-export": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/no-length-as-slice-end": "error",
    "unicorn/no-magic-array-flat-depth": "error",
    "unicorn/no-process-exit": "error",
    "unicorn/no-useless-error-capture-stack-trace": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-module": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",

    "react/no-unknown-property": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "metadata",
          "generateMetadata",
          "generateStaticParams",
          "revalidate",
          "dynamic",
          "dynamicParams",
          "fetchCache",
          "runtime",
          "preferredRegion",
          "maxDuration",
          "experimental_ppr",
          "viewport",
          "generateViewport"
        ]
      }
    ],

    "react/react-in-jsx-scope": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-handler-names": "off",
    "unicorn/filename-case": "off",
    "typescript/method-signature-style": "off",

    "capitalized-comments": "off",
    "func-style": "off",
    "func-names": "off",
    "func-name-matching": "off",
    "id-length": "off",
    "id-denylist": "off",
    "id-match": "off",
    "init-declarations": "off",
    "max-params": "off",
    "max-statements": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-classes-per-file": "off",
    "max-depth": "off",
    "max-nested-callbacks": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "no-continue": "off",
    "no-underscore-dangle": "off",
    "no-duplicate-imports": "off",
    "no-inline-comments": "off",
    "no-warning-comments": "off",
    "no-await-in-loop": "off",
    "sort-keys": "off",
    "sort-vars": "off",
    "vars-on-top": "off",
    "prefer-destructuring": "off",
    "prefer-named-capture-group": "off",
    "arrow-body-style": "off",
    "oxc/branches-sharing-code": "off"
  },
  "overrides": [
    {
      "files": ["*.config.js", "*.config.ts", "*.config.mjs", "*.config.cjs", "*.config.mts"],
      "rules": {
        "no-console": "off",
        "unicorn/prefer-module": "off",
        "unicorn/no-anonymous-default-export": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/no-var-requires": "off",
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/no-empty-object-type": "off",
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**",
        "**/__fixtures__/**"
      ],
      "env": {
        "node": true,
        "vitest": true,
        "jest": true
      },
      "rules": {
        "no-console": "off",
        "no-shadow": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-var-requires": "off",
        "typescript/no-require-imports": "off",
        "typescript/no-non-null-assertion": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-module": "off"
      }
    },
    {
      "files": ["app/**/route.ts", "app/**/route.tsx"],
      "rules": {
        "require-await": "off"
      }
    },
    {
      "files": ["**/fetcher.ts", "**/mappers.ts", "**/*-mappers.ts", "**/*-fetcher.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["lib/suncalc.ts"],
      "rules": {
        "unicorn/prefer-math-trunc": "off",
        "unicorn/numeric-separators-style": "off",
        "unicorn/no-negated-condition": "off",
        "no-negated-condition": "off",
        "no-else-return": "off"
      }
    },
    {
      "files": ["components/NextHoursChart.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["tabpanel", "group"] }]
      }
    }
  ]
}
